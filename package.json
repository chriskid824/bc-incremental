{
  "name": "bc-incremental",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:electron": "vite build --mode steam && vite build --config vite.electron.config.ts --mode main && vite build --config vite.electron.config.ts --mode preload",
    "build:steam": "npm run typecheck && npm run build:electron",
    "preview": "vite preview",
    "electron:install": "install-electron",
    "electron": "npm run build:electron && electron .",
    "smoke:electron": "npm run build:electron && tsx tools/electron/smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.sim.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "balance": "tsx tools/balance/cli.ts",
    "bench": "tsx tools/balance/bench.ts",
    "fingerprint": "tsx tools/balance/fingerprint.ts",
    "snapshots": "tsx tools/content/snapshots.ts",
    "content": "tsx tools/content/check.ts",
    "calibrate": "tsx tools/content/calibrate.ts",
    "fuzz:web": "tsx tools/content/fuzzWeb.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "pixi.js": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "electron": "44.8.0",
    "eslint": "9.39.5",
    "globals": "16.5.0",
    "prettier": "3.9.10",
    "steamworks.js": "0.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.7",
    "vitest": "5.0.4"
  },
  "overrides": {
    "electron": {
      "@electron-internal/extract-zip": "1.0.5",
      "@types/node": "$@types/node"
    }
  }
}
